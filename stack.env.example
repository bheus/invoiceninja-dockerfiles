APP_URL=http://in.localhost:8003/
APP_KEY=base64:replace-with-generated-app-key
APP_ENV=production
APP_DEBUG=false
REQUIRE_HTTPS=false
PHANTOMJS_PDF_GENERATION=false
PDF_GENERATOR=snappdf
TRUSTED_PROXIES=*

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=debian_docker

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ninja
DB_USERNAME=ninja
DB_PASSWORD=replace-with-random-db-password
DB_ROOT_PASSWORD=replace-with-random-root-password
DB_CONNECTION=mysql

IN_USER_EMAIL=admin@example.com
IN_PASSWORD=replace-with-temporary-bootstrap-password

MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=user@example.com
MAIL_FROM_NAME=Self Hosted User

MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_USER=ninja
MYSQL_PASSWORD=replace-with-random-db-password
MYSQL_DATABASE=ninja

NORDIGEN_SECRET_ID=
NORDIGEN_SECRET_KEY=

IS_DOCKER=true
SCOUT_DRIVER=null
